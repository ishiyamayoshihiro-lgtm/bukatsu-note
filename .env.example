# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google Cloud Console > 認証情報 > OAuth 2.0 クライアント ID で取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32  で生成したランダム文字列
NEXTAUTH_SECRET=
# 本番では https://your-domain.com に変更
NEXTAUTH_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL の接続文字列（Supabase / Neon / Railway など）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bukatsu_note?schema=public"

# ローカル開発で SQLite を使う場合（schema.prisma の provider も変更すること）
# DATABASE_URL="file:./dev.db"

# ── Google Sheets API ─────────────────────────────────────────────────────────
# Google Cloud の サービスアカウント メールアドレス
GOOGLE_CLIENT_EMAIL=
# Google Cloud の サービスアカウント 秘密鍵（JSON のテキスト）
GOOGLE_PRIVATE_KEY=
# 提出状況を書き込む Spreadsheet ID
SPREADSHEET_ID=
# Cron リクエスト認証用トークン（openssl rand -base64 32 で生成）
CRON_SECRET=
